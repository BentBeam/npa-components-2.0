{
  "name": "@npa-eval/components2.0",
  "version": "0.1.0",
  "description": "NPA Logistik Designsystem 2.0 – React- och Tailwind-komponenter genererade från NPA:s Figma-bibliotek.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "build": "node scripts/generate-safelist.mjs && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/postbuild-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "icons:generate": "node scripts/generate-icons.mjs",
    "release": "node scripts/release.mjs",
    "figma:validate": "figma connect publish --dry-run --label React",
    "figma:publish": "figma connect publish --label React",
    "check:komponenter": "node scripts/check-komponenter.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:komponenter",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "bootstrap-icons": "^1.13.1",
    "chromatic": "^18.9.4",
    "oxlint": "^1.69.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
